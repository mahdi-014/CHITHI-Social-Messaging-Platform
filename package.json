{
  "name": "chithi-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CHITHI — Web-first, Friend-based Social Messaging Platform",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:api": "pnpm --filter @chithi/api start:dev",
    "dev:web": "pnpm --filter @chithi/web dev",
    "build:api": "pnpm --filter @chithi/api build",
    "build:web": "pnpm --filter @chithi/web build",
    "build": "pnpm --filter \"@chithi/*\" build",
    "test": "pnpm --filter \"@chithi/*\" test",
    "lint": "pnpm --filter \"@chithi/*\" lint",
    "db:backup": "node apps/api/scripts/backup-db.js",
    "db:restore": "node apps/api/scripts/restore-db.js",
    "db:cleanup": "node apps/api/scripts/cleanup-synthetic-test-data.js",
    "db:verify": "node apps/api/scripts/verify-db-schema-constraints.js",
    "db:smoke:cleanup": "node apps/api/scripts/production-smoke-test-cleanup.js"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "qs": "6.17.1",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "file-type": "21.3.4",
    "zod": "4.6.6",
    "postcss": "8.5.32"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
