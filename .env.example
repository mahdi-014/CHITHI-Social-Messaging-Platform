# =================================================================
# CHITHI — Environment Configuration Template
# Copy this file to .env for local development
# For production, copy to .env.prod with secure random secrets
# =================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Client Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# PostgreSQL Database Configuration
POSTGRES_USER=chithi
POSTGRES_PASSWORD=chithi_secret
POSTGRES_DB=chithi_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chithi:chithi_secret@localhost:5432/chithi_db?schema=public

# Redis Configuration (Optional / Distributed Cache)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets (Generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=chithi_super_secret_jwt_access_key_2026_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=chithi_super_secret_jwt_refresh_key_2026_dev
JWT_REFRESH_EXPIRES_IN=7d

# Media Storage Configuration ('local' or 's3')
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# S3 / MinIO Object Storage (Required only when STORAGE_PROVIDER=s3)
MINIO_ROOT_USER=chithi_minio
MINIO_ROOT_PASSWORD=chithi_minio_secret
MINIO_PORT=9000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=chithi_minio
S3_SECRET_KEY=chithi_minio_secret
S3_BUCKET_NAME=chithi-media
S3_FORCE_PATH_STYLE=true

# WebRTC STUN & TURN Configuration
# Free Google STUN servers for NAT traversal discovery
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Coturn TURN Relay (Required for restrictive firewalls / symmetric NATs)
# Shared secret for RFC 5766 HMAC-SHA1 ephemeral credentials
TURN_SECRET=
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_TTL_SECONDS=86400
