# ==============================================================================
# CHITHI — Staging Environment Template (.env.staging)
# ==============================================================================
NODE_ENV=staging
STAGING_PORT=8080

POSTGRES_USER=chithi_staging
POSTGRES_PASSWORD=GENERATE_SECURE_STAGING_PASSWORD
POSTGRES_DB=chithi_staging_db

JWT_ACCESS_SECRET=GENERATE_SECURE_STAGING_ACCESS_SECRET
JWT_REFRESH_SECRET=GENERATE_SECURE_STAGING_REFRESH_SECRET

NEXT_PUBLIC_API_URL=http://staging.yourdomain.com/api/v1
NEXT_PUBLIC_SOCKET_URL=http://staging.yourdomain.com
CORS_ORIGIN=http://staging.yourdomain.com

TURN_SECRET=GENERATE_SECURE_STAGING_TURN_SECRET
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

