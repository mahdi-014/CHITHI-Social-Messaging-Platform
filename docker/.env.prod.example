# =================================================================
# CHITHI — Production Environment Configuration (.env.prod)
# Copy this file to .env.prod on your production host
# DO NOT COMMIT ACTUAL PRODUCTION VALUES TO VERSION CONTROL
# =================================================================

# 1. Environment & Network
NODE_ENV=production
PORT=4000
HOSTNAME=0.0.0.0

# 2. Public Domain & Routing
# Set to your fully-qualified domain name (FQDN)
# Example: https://chithi.yourdomain.com
NEXT_PUBLIC_API_URL=https://chithi.yourdomain.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://chithi.yourdomain.com
CORS_ORIGIN=https://chithi.yourdomain.com

# 3. PostgreSQL Production Database
# Generate secure password with: openssl rand -hex 24
POSTGRES_USER=chithi
POSTGRES_PASSWORD=GENERATE_SECURE_PASSWORD_HERE
POSTGRES_DB=chithi_db
DATABASE_URL=postgresql://chithi:GENERATE_SECURE_PASSWORD_HERE@postgres:5432/chithi_db?schema=public&connection_limit=25&pool_timeout=15

# 4. Authentication Secrets
# Generate 256-bit secrets with: openssl rand -hex 32
JWT_ACCESS_SECRET=GENERATE_SECURE_ACCESS_SECRET_HERE
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=GENERATE_SECURE_REFRESH_SECRET_HERE
JWT_REFRESH_EXPIRES_IN=7d

# 5. Persistent Media Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/app/uploads

# 6. WebRTC STUN & TURN Configuration
# Discovery STUN servers
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Coturn TURN Relay for symmetric NAT traversal
# Match static-auth-secret in /etc/turnserver.conf (generate with: openssl rand -hex 32)
TURN_SECRET=GENERATE_SECURE_TURN_SECRET_HERE
TURN_SERVER_URL=turn:turn.yourdomain.com:3478
TURN_URLS=turn:turn.yourdomain.com:3478?transport=udp,turn:turn.yourdomain.com:3478?transport=tcp
TURN_TTL_SECONDS=86400

# 7. Nginx Production Configuration Override (Optional)
# NGINX_CONF=./docker/nginx/nginx.prod.conf
